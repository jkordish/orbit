#!/bin/bash
# Validate profile choices before installing packages or writing configuration.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
mode=${1:---list}
if [ "$#" -gt 0 ]; then shift; fi
config_file="$root/config/profiles.txt"
state_root="$root/.state"
state_file="$state_root/profiles.txt"
# Keep this list aligned with profiles/*.Brewfile. The explicit list also lets
# this validator work when copied on its own by setup diagnostics and checks.
available_profiles=(autocomplete cloud editors infra java wasm)
usage() { echo 'Usage: scripts/profiles [--list|--validate|--select|--resolve|--verify-catalog|--install|--check|--update] [--profile NAME|all ...]' >&2; }
valid() {
  local candidate
  for candidate in "${available_profiles[@]}"; do
    if [ "$candidate" = "$1" ]; then return 0; fi
  done
  echo "Unknown profile: $1" >&2
  return 2
}
validate_file() {
  local file=$1 name
  [ -f "$file" ] || return 0
  while IFS= read -r name || [ -n "$name" ]; do
    case "$name" in ''|\#*) continue ;; esac
    valid "$name"
  done < "$file"
}
selected() {
  local name=$1 file
  for file in "$config_file" "$state_file"; do
    [ -f "$file" ] && grep -Fxq "$name" "$file" && return 0
  done
  return 1
}
append_once() {
  local name=$1 candidate
  if [ "${#resolved[@]}" -gt 0 ]; then
    for candidate in "${resolved[@]}"; do
      if [ "$candidate" = "$name" ]; then return 0; fi
    done
  fi
  resolved+=("$name")
}
validate_file "$config_file"
validate_file "$state_file"
requested=()
while [ "$#" -gt 0 ]; do
  if [ "$1" != --profile ] || [ "$#" -lt 2 ]; then usage; exit 2; fi
  if [ "$2" = all ]; then
    requested+=("${available_profiles[@]}")
  else
    valid "$2"
    requested+=("$2")
  fi
  shift 2
done
case "$mode" in
  --validate) exit 0 ;;
  --resolve)
    resolved=()
    for file in "$config_file" "$state_file"; do
      [ -f "$file" ] || continue
      while IFS= read -r name || [ -n "$name" ]; do
        case "$name" in ''|\#*) continue ;; esac
        append_once "$name"
      done < "$file"
    done
    if [ "${#requested[@]}" -gt 0 ]; then
      for name in "${requested[@]}"; do append_once "$name"; done
    fi
    if [ "${#resolved[@]}" -gt 0 ]; then printf '%s\n' "${resolved[@]}"; fi
    exit 0 ;;
  --verify-catalog)
    [ "${#requested[@]}" -eq 0 ] || { usage; exit 2; }
    for name in "${available_profiles[@]}"; do
      if [ ! -f "$root/profiles/$name.Brewfile" ]; then
        printf 'Missing Brewfile for profile: %s\n' "$name" >&2
        exit 1
      fi
    done
    for brewfile in "$root"/profiles/*.Brewfile; do
      [ -f "$brewfile" ] || continue
      name=${brewfile##*/}
      valid "${name%.Brewfile}"
    done
    exit 0 ;;
  --select)
    [ "${#requested[@]}" -gt 0 ] || exit 0
    if [ -L "$state_root" ] || [ -L "$state_root/backups" ] || [ -L "$state_file" ]; then
      echo 'Refusing to write profile state through a symbolic link under .state.' >&2
      exit 1
    fi
    mkdir -p "$state_root"
    for name in "${requested[@]}"; do
      if ! selected "$name"; then printf '%s\n' "$name" >> "$state_file"; fi
    done
    exit 0 ;;
  --list)
    printf 'Available: all, %s\nEnabled:\n' "${available_profiles[*]}"
    for file in "$config_file" "$state_file"; do
      [ -f "$file" ] || continue
      while IFS= read -r name || [ -n "$name" ]; do
        case "$name" in ''|\#*) continue ;; esac
        printf '%s\n' "$name"
      done < "$file"
    done
    exit 0 ;;
  --install|--check|--update) ;;
  *) usage; exit 2 ;;
esac

install_profile() {
  local name=$1
  if [ "$mode" = --install ] || [ "$mode" = --update ]; then
    if brew help trust >/dev/null 2>&1; then
      case "$name" in
        cloud) brew trust --formula aws/tap/ec2-metadata-mock aws/tap/eks-node-viewer nklmilojevic/sofka/sofka ;;
        infra) brew trust --cask terraform-linters/tap/tflint ;;
        wasm) brew trust --formula spinframework/tap/spin wasmcloud/wasmcloud/wash ;;
      esac
    fi
  fi
  case "$mode" in
    --install) brew bundle install --file="$root/profiles/$name.Brewfile" --no-upgrade ;;
    --update) brew bundle install --file="$root/profiles/$name.Brewfile" ;;
    --check) brew bundle check --file="$root/profiles/$name.Brewfile" ;;
  esac
}
for file in "$config_file" "$state_file"; do
  [ -f "$file" ] || continue
  while IFS= read -r name || [ -n "$name" ]; do
    case "$name" in ''|\#*) continue ;; esac
    install_profile "$name"
  done < "$file"
done
