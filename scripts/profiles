#!/bin/bash
# Validate profile choices before installing packages or writing configuration.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd -P)
mode=${1:---list}
if [ "$#" -gt 0 ]; then shift; fi
config_file="$root/config/profiles.txt"
state_root="$root/.state"
state_file="$state_root/profiles.txt"
# Keep this list aligned with profiles/*.Brewfile. The explicit list also lets
# this validator work when copied on its own by setup diagnostics and checks.
available_profiles=(ai-dev autocomplete cloud editors infra java wasm)
usage() { echo 'Usage: scripts/profiles [--list|--validate|--select|--resolve|--verify-catalog|--install|--check|--update] [--profile NAME|all ...]' >&2; }
valid() {
  local candidate
  for candidate in "${available_profiles[@]}"; do
    if [ "$candidate" = "$1" ]; then return 0; fi
  done
  echo "Unknown profile: $1" >&2
  return 2
}
validate_file() {
  local file=$1 name
  [ -f "$file" ] || return 0
  while IFS= read -r name || [ -n "$name" ]; do
    case "$name" in ''|\#*) continue ;; esac
    valid "$name"
  done < "$file"
}
selected() {
  local name=$1 file
  for file in "$config_file" "$state_file"; do
    [ -f "$file" ] && grep -Fxq "$name" "$file" && return 0
  done
  return 1
}
append_once() {
  local name=$1 candidate
  if [ "${#resolved[@]}" -gt 0 ]; then
    for candidate in "${resolved[@]}"; do
      if [ "$candidate" = "$name" ]; then return 0; fi
    done
  fi
  resolved+=("$name")
}

profile_description() {
  case "$1" in
    ai-dev) printf 'Datasets, model artifacts, and benchmarks' ;;
    autocomplete) printf 'Inline Zsh completion suggestions' ;;
    cloud) printf 'AWS, Kubernetes, Helm, and Argo CD' ;;
    editors) printf 'Helix, language servers, and Tree-sitter' ;;
    infra) printf 'Ansible, Terraform tools, and linters' ;;
    java) printf 'OpenJDK 21 for JVM work' ;;
    wasm) printf 'Spin, wasmCloud, WasmEdge, and Wasmer' ;;
  esac
}

terminal_columns() {
  local size
  if size=$(stty size 2>/dev/null </dev/tty); then
    size=${size##* }
    if [ "$size" -gt 0 ] 2>/dev/null; then
      printf '%s\n' "$size"
      return
    fi
  fi
  printf '%s\n' "${COLUMNS:-80}"
}

rule() {
  local spaces
  printf -v spaces '%*s' "$1" ''
  printf '%s' "${spaces// /─}"
}

wrap_note() {
  local remaining=$1 marker=${2:-·} tone=${3:-$color_muted}
  local limit=$((width - 4)) chunk first=1
  while [ "${#remaining}" -gt "$limit" ]; do
    chunk=${remaining:0:limit}
    if [[ $chunk == *' '* ]]; then chunk=${chunk% *}; fi
    if [ -z "$chunk" ]; then chunk=${remaining:0:limit}; fi
    if [ "$first" -eq 1 ]; then
      printf '  %s%s%s %s\n' "$tone" "$marker" "$color_reset" "$chunk"
      first=0
    else
      printf '    %s\n' "$chunk"
    fi
    remaining=${remaining:${#chunk}}
    while [[ $remaining == ' '* ]]; do remaining=${remaining# }; done
  done
  if [ "$first" -eq 1 ]; then
    printf '  %s%s%s %s\n' "$tone" "$marker" "$color_reset" "$remaining"
  else
    printf '    %s\n' "$remaining"
  fi
}

list_tty() {
  local name description selected_count=0 state marker tone title
  width=$(terminal_columns)
  case "$width" in
    ''|*[!0-9]*) width=80 ;;
  esac
  if [ "$width" -lt 24 ]; then width=24; fi
  if [ "$width" -gt 96 ]; then width=96; fi
  color_reset=''
  color_indigo=''
  color_mint=''
  color_muted=''
  color_amber=''
  if [ -z "${NO_COLOR+x}" ]; then
    color_reset=$'\033[0m'
    color_indigo=$'\033[38;2;180;190;254m'
    color_mint=$'\033[38;2;148;226;213m'
    color_muted=$'\033[38;2;166;173;200m'
    color_amber=$'\033[38;2;249;226;175m'
  fi
  for name in "${available_profiles[@]}"; do
    if selected "$name"; then selected_count=$((selected_count + 1)); fi
  done

  title=' ◉ ORBIT / PROFILES '
  if [ "$width" -lt 32 ]; then title=' ◉ ORBIT '; fi
  printf '\n%s╭─%s%s╮%s\n' "$color_indigo" "$title" \
    "$(rule "$((width - 3 - ${#title}))")" "$color_reset"
  printf '│  %s%-*s%s│\n' "$color_mint" "$((width - 4))" \
    "$selected_count of ${#available_profiles[@]} selected" "$color_reset"
  printf '%s╰%s╯%s\n' "$color_indigo" "$(rule "$((width - 2))")" "$color_reset"
  wrap_note 'Base tools are always included.'
  if [ "$selected_count" -lt "${#available_profiles[@]}" ]; then
    wrap_note '--profile all selects every optional profile.'
  else
    wrap_note 'Every optional profile is selected.'
  fi
  wrap_note 'Selected profiles are not an installed-package check.'

  printf '\n  %sOPTIONAL PROFILES%s %s%s%s\n' "$color_indigo" "$color_reset" \
    "$color_muted" "$(rule "$((width - 22))")" "$color_reset"
  for name in "${available_profiles[@]}"; do
    description=$(profile_description "$name")
    if selected "$name"; then
      state='SELECTED'
      marker='●'
      tone=$color_mint
    else
      state='AVAILABLE'
      marker='◇'
      tone=$color_amber
    fi
    if [ "$width" -ge 72 ]; then
      printf '  %s%s %-9s%s %-13s %s\n' "$tone" "$marker" "$state" "$color_reset" \
        "$name" "$description"
    else
      printf '  %s%s%s %s\n' "$tone" "$marker" "$color_reset" "$name"
      wrap_note "$state · $description"
    fi
  done
  printf '\n  %sNEXT%s %s%s%s\n' "$color_indigo" "$color_reset" \
    "$color_muted" "$(rule "$((width - 8))")" "$color_reset"
  if [ "$selected_count" -lt "${#available_profiles[@]}" ]; then
    wrap_note 'Preview a choice with orbit plan --profile NAME.' '↳' "$color_amber"
  else
    wrap_note 'Preview selected settings with orbit plan.' '↳' "$color_amber"
  fi
  printf '\n'
}

validate_file "$config_file"
validate_file "$state_file"
requested=()
while [ "$#" -gt 0 ]; do
  if [ "$1" != --profile ] || [ "$#" -lt 2 ]; then usage; exit 2; fi
  if [ "$2" = all ]; then
    requested+=("${available_profiles[@]}")
  else
    valid "$2"
    requested+=("$2")
  fi
  shift 2
done
case "$mode" in
  --validate) exit 0 ;;
  --resolve)
    resolved=()
    for file in "$config_file" "$state_file"; do
      [ -f "$file" ] || continue
      while IFS= read -r name || [ -n "$name" ]; do
        case "$name" in ''|\#*) continue ;; esac
        append_once "$name"
      done < "$file"
    done
    if [ "${#requested[@]}" -gt 0 ]; then
      for name in "${requested[@]}"; do append_once "$name"; done
    fi
    if [ "${#resolved[@]}" -gt 0 ]; then printf '%s\n' "${resolved[@]}"; fi
    exit 0 ;;
  --verify-catalog)
    [ "${#requested[@]}" -eq 0 ] || { usage; exit 2; }
    for name in "${available_profiles[@]}"; do
      if [ ! -f "$root/profiles/$name.Brewfile" ]; then
        printf 'Missing Brewfile for profile: %s\n' "$name" >&2
        exit 1
      fi
    done
    for brewfile in "$root"/profiles/*.Brewfile; do
      [ -f "$brewfile" ] || continue
      name=${brewfile##*/}
      valid "${name%.Brewfile}"
    done
    exit 0 ;;
  --select)
    [ "${#requested[@]}" -gt 0 ] || exit 0
    if [ -L "$state_root" ] || [ -L "$state_root/backups" ] || [ -L "$state_file" ]; then
      echo 'Refusing to write profile state through a symbolic link under .state.' >&2
      exit 1
    fi
    mkdir -p "$state_root"
    for name in "${requested[@]}"; do
      if ! selected "$name"; then printf '%s\n' "$name" >> "$state_file"; fi
    done
    exit 0 ;;
  --list)
    if [ -t 1 ] && [ "${TERM:-}" != dumb ]; then
      list_tty
    else
      printf 'Available: all, %s\nEnabled:\n' "${available_profiles[*]}"
      for file in "$config_file" "$state_file"; do
        [ -f "$file" ] || continue
        while IFS= read -r name || [ -n "$name" ]; do
          case "$name" in ''|\#*) continue ;; esac
          printf '%s\n' "$name"
        done < "$file"
      done
    fi
    exit 0 ;;
  --install|--check|--update) ;;
  *) usage; exit 2 ;;
esac

install_profile() {
  local name=$1
  if [ "$mode" = --install ] || [ "$mode" = --update ]; then
    if brew help trust >/dev/null 2>&1; then
      case "$name" in
        cloud) brew trust --formula aws/tap/ec2-metadata-mock aws/tap/eks-node-viewer nklmilojevic/sofka/sofka ;;
        infra) brew trust --cask terraform-linters/tap/tflint ;;
        wasm) brew trust --formula spinframework/tap/spin wasmcloud/wasmcloud/wash ;;
      esac
    fi
  fi
  case "$mode" in
    --install) brew bundle install --file="$root/profiles/$name.Brewfile" --no-upgrade ;;
    --update) brew bundle install --file="$root/profiles/$name.Brewfile" ;;
    --check) brew bundle check --file="$root/profiles/$name.Brewfile" ;;
  esac
}
for file in "$config_file" "$state_file"; do
  [ -f "$file" ] || continue
  while IFS= read -r name || [ -n "$name" ]; do
    case "$name" in ''|\#*) continue ;; esac
    install_profile "$name"
  done < "$file"
done
