#!/bin/bash
set -euo pipefail

# This list drives both the read-only plan and the apply step. Keep values
# scalar so they can be passed directly to `defaults write` without eval.
preferences() {
  cat <<'PREFERENCES'
NSGlobalDomain	AppleShowAllExtensions	bool	true
NSGlobalDomain	AppleShowAllFiles	bool	true
NSGlobalDomain	InitialKeyRepeat	int	15
NSGlobalDomain	KeyRepeat	int	2
NSGlobalDomain	NSAutomaticCapitalizationEnabled	bool	false
NSGlobalDomain	NSAutomaticDashSubstitutionEnabled	bool	false
NSGlobalDomain	NSAutomaticPeriodSubstitutionEnabled	bool	false
NSGlobalDomain	NSAutomaticQuoteSubstitutionEnabled	bool	false
NSGlobalDomain	NSAutomaticSpellingCorrectionEnabled	bool	false
NSGlobalDomain	NSNavPanelExpandedStateForSaveMode	bool	true
NSGlobalDomain	NSNavPanelExpandedStateForSaveMode2	bool	true
com.apple.finder	ShowPathbar	bool	true
com.apple.finder	ShowStatusBar	bool	true
com.apple.finder	_FXShowPosixPathInTitle	bool	true
com.apple.finder	FXDefaultSearchScope	string	SCcf
com.apple.finder	FXPreferredViewStyle	string	Nlsv
com.apple.finder	QLEnableTextSelection	bool	true
com.apple.desktopservices	DSDontWriteNetworkStores	bool	true
com.apple.desktopservices	DSDontWriteUSBStores	bool	true
PREFERENCES
}

if [ "$#" -eq 1 ] && [ "$1" = '--plan' ]; then
  preferences
  exit 0
fi
if [ "$#" -ne 0 ]; then
  printf 'Usage: %s [--plan]\n' "$0" >&2
  exit 2
fi

source "$(dirname "$0")/env.sh"
backup_root="$ORBIT_ROOT/.state/backups"
if [ -L "$ORBIT_ROOT/.state" ] || [ -L "$backup_root" ]; then
  printf 'Refusing symbolic-link backup path: %s\n' "$backup_root" >&2
  exit 1
fi
umask 077
mkdir -p "$backup_root"
chmod 700 "$backup_root"
stamp=$(date +%Y%m%dT%H%M%S)

backup_if_changed() {
  local domain=$1
  local name=$2
  local temporary="$backup_root/.${name}.snapshot.$$"
  local candidate
  local digest

  if ! defaults export "$domain" "$temporary" >/dev/null; then
    rm -f "$temporary"
    return 1
  fi
  chmod 600 "$temporary"
  digest=$(shasum -a 256 "$temporary" | awk '{print $1}')
  for candidate in "$backup_root/$name".*.plist; do
    if [ -L "$candidate" ]; then
      rm -f "$temporary"
      printf 'Refusing symbolic-link backup: %s\n' "$candidate" >&2
      return 1
    fi
    [ -f "$candidate" ] || continue
    if [ "$(shasum -a 256 "$candidate" | awk '{print $1}')" = "$digest" ]; then
      rm -f "$temporary"
      printf 'Unchanged · %s backup already preserved.\n' "$name"
      return 0
    fi
  done

  candidate="$backup_root/$name.$stamp.$$.plist"
  mv -n "$temporary" "$candidate"
  if [ -e "$temporary" ]; then
    rm -f "$temporary"
    printf 'Refusing to overwrite backup: %s\n' "$candidate" >&2
    return 1
  fi
  printf 'Preserved · %s defaults snapshot.\n' "$name"
}

backup_if_changed com.apple.finder finder
backup_if_changed NSGlobalDomain global
backup_if_changed com.apple.desktopservices desktopservices

preferences | while IFS=$'\t' read -r domain key type value; do
  defaults write "$domain" "$key" "-$type" "$value"
done
echo 'Developer-friendly macOS defaults saved; Finder and text-field changes take effect after the relevant apps restart.'
