#!/bin/bash
set -euo pipefail

ORBIT_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

color_reset=''
color_indigo=''
color_mint=''
color_amber=''
color_rose=''
color_muted=''
if [ -t 1 ] && [ -z "${NO_COLOR+x}" ] && [ "${TERM:-}" != dumb ]; then
  color_reset=$'\033[0m'
  color_indigo=$'\033[38;2;180;190;254m'
  color_mint=$'\033[38;2;148;226;213m'
  color_amber=$'\033[38;2;249;226;175m'
  color_rose=$'\033[38;2;243;139;168m'
  color_muted=$'\033[38;2;166;173;200m'
fi

usage_plain() {
  cat <<EOF
${color_indigo}ORBIT${color_reset} / ORBIT COMMAND CENTER

Usage: orbit <command> [options]

Read-only views
  ${color_mint}status${color_reset}       Machine readiness (alias: doctor)
  ${color_mint}repo${color_reset}         Read-only Git state for a checkout
  ${color_mint}recovery${color_reset}     Inventory preserved setup backups
  ${color_mint}profiles${color_reset}     Explore optional tool profiles
  ${color_mint}projects${color_reset}     Inventory project language manifests
  ${color_mint}map${color_reset}          Map project tools; add --git or --needs
  ${color_mint}enter${color_reset}        Inspect a project's local tool readiness
  ${color_mint}plan${color_reset}         Preview setup scope and changes

Explicit actions
  ${color_amber}provision${color_reset}   Run the complete one-step workstation setup (alias: setup)
  ${color_amber}sync${color_reset}        Safely return this checkout to main
  ${color_amber}services${color_reset}    Govern container runtimes
  ${color_amber}check${color_reset}       Run repository validation
  ${color_amber}new${color_reset}         Browse or create a starter project
  ${color_amber}update${color_reset}      Update packages from a clean checkout

Examples
  orbit status --docker
  orbit status --json
  orbit profiles
  orbit repo ~/src/my-project
  orbit enter ~/src/my-project
  orbit projects --json
  orbit map ~/src
  orbit map ~/src --git
  orbit map ~/src --needs
  orbit plan --profile all
  orbit new --list
  orbit new python morning-brief ~/src --git --commit
  orbit sync
  orbit services status
  orbit services sleep

Read-only status, projects, enter, map, and plan also support --json. Actions are never
inferred from a view; use the explicit subcommand when you want one.
EOF
}

terminal_columns() {
  local size
  if size=$(stty size 2>/dev/null </dev/tty); then
    size=${size##* }
    if [ "$size" -gt 0 ] 2>/dev/null; then
      printf '%s\n' "$size"
    else
      printf '%s\n' "${COLUMNS:-80}"
    fi
  else
    printf '%s\n' "${COLUMNS:-80}"
  fi
}

usage_description() {
  local remaining=$1 limit=$2 chunk
  while [ "${#remaining}" -gt "$limit" ]; do
    chunk=${remaining:0:limit}
    if [[ $chunk == *' '* ]]; then chunk=${chunk% *}; fi
    if [ -z "$chunk" ]; then chunk=${remaining:0:limit}; fi
    printf '      %s\n' "$chunk"
    remaining=${remaining:${#chunk}}
    while [[ $remaining == ' '* ]]; do remaining=${remaining# }; done
  done
  printf '      %s\n' "$remaining"
}

usage_item() {
  local command_name=$1 description=$2 tone=$3 width=$4
  if [ "$width" -ge 58 ]; then
    printf '    %s%-16s%s %s\n' "$tone" "$command_name" "$color_reset" "$description"
  else
    printf '    %s%s%s\n' "$tone" "$command_name" "$color_reset"
    usage_description "$description" "$((width - 6))"
  fi
}

usage_tty() {
  local width rule tagline
  width=$(terminal_columns)
  case "$width" in
    ''|*[!0-9]*) width=80 ;;
  esac
  if [ "$width" -lt 20 ]; then width=20; fi
  if [ "$width" -gt 100 ]; then width=100; fi
  printf -v rule '%*s' "$((width - 2))" ''
  rule=${rule// /─}
  tagline='Your workstation command center'
  if [ "$width" -lt 40 ]; then tagline='Ready to build'; fi

  printf '\n  %s◉ ORBIT%s\n' "$color_indigo" "$color_reset"
  printf '  %s%s%s\n' "$color_muted" "$tagline" "$color_reset"
  printf '  %s%s%s\n' "$color_muted" "$rule" "$color_reset"
  printf '\n  %sSTART HERE%s\n' "$color_indigo" "$color_reset"
  usage_item 'orbit status' 'See what needs attention' "$color_mint" "$width"
  usage_item 'orbit map --git' 'Survey project tools and Git' "$color_mint" "$width"
  usage_item 'orbit plan' 'Preview setup scope' "$color_mint" "$width"

  printf '\n  %sEXPLORE%s  %sread-only%s\n' "$color_indigo" "$color_reset" "$color_muted" "$color_reset"
  usage_item 'status' 'Machine readiness (doctor)' "$color_mint" "$width"
  usage_item 'repo' 'Inspect one checkout' "$color_mint" "$width"
  usage_item 'recovery' 'Review saved backups' "$color_mint" "$width"
  usage_item 'profiles' 'Explore optional tool profiles' "$color_mint" "$width"
  usage_item 'projects' 'Find project manifests' "$color_mint" "$width"
  usage_item 'map' 'Survey projects; --git and --needs add detail' "$color_mint" "$width"
  usage_item 'enter' 'Check a project toolchain' "$color_mint" "$width"
  usage_item 'plan' 'Preview setup scope and changes' "$color_mint" "$width"

  if [ "$width" -lt 32 ]; then
    printf '\n  %sMAKE CHANGES%s\n' "$color_indigo" "$color_reset"
  else
    printf '\n  %sMAKE CHANGES%s  %sexplicit only%s\n' "$color_indigo" "$color_reset" "$color_muted" "$color_reset"
  fi
  usage_item 'provision' 'Set up this workstation (setup)' "$color_amber" "$width"
  usage_item 'sync' 'Safely return to main' "$color_amber" "$width"
  usage_item 'services' 'Manage container runtimes' "$color_amber" "$width"
  usage_item 'check' 'Validate this repository' "$color_amber" "$width"
  usage_item 'new' 'Browse or create a starter project' "$color_amber" "$width"
  usage_item 'update' 'Update packages from clean Git' "$color_amber" "$width"

  printf '\n  %sTRY NEXT%s\n' "$color_indigo" "$color_reset"
  if [ "$width" -lt 38 ]; then
    printf '    %sorbit status%s\n' "$color_mint" "$color_reset"
    printf '    %sorbit map --git%s\n' "$color_mint" "$color_reset"
    printf '    %sorbit plan%s\n' "$color_mint" "$color_reset"
    printf '    %sorbit provision%s\n' "$color_amber" "$color_reset"
  else
    printf '    %sorbit plan --profile all%s\n' "$color_mint" "$color_reset"
    printf '    %sorbit provision --profile all%s\n' "$color_amber" "$color_reset"
    printf '    %sorbit new python my-app ~/src%s\n' "$color_amber" "$color_reset"
  fi
  printf '\n  %sJSON OUTPUT%s\n' "$color_indigo" "$color_reset"
  usage_description 'status, projects, enter, map, plan' "$((width - 6))"
  printf '\n'
}

usage() {
  if [ -t 1 ] && [ "${TERM:-}" != dumb ]; then
    usage_tty
  else
    usage_plain
  fi
}

run_script() {
  local script=$1
  shift
  exec "$ORBIT_ROOT/scripts/$script" "$@"
}

run_setup() {
  exec "$ORBIT_ROOT/setup" "$@"
}

command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi

case "$command" in
  help|--help|-h)
    if [ "$#" -gt 0 ]; then
      usage >&2
      exit 2
    fi
    usage
    ;;
  status|doctor)
    run_script doctor "$@"
    ;;
  repo|repository)
    run_script repository-status "$@"
    ;;
  recovery)
    run_script recovery "$@"
    ;;
  profiles)
    if [ "$#" -eq 1 ] && [ "$1" = --help ]; then
      printf 'Usage: orbit profiles\nExplore optional profiles without changing selection.\n'
      exit 0
    fi
    if [ "$#" -ne 0 ]; then
      printf 'Usage: orbit profiles\n' >&2
      exit 2
    fi
    run_script profiles --list
    ;;
  projects|workspace)
    run_script projects "$@"
    ;;
  map)
    run_script orbit-python map "$@"
    ;;
  enter)
    run_script enter "$@"
    ;;
  plan)
    run_script plan "$@"
    ;;
  provision|setup)
    run_setup "$@"
    ;;
  sync)
    run_script sync "$@"
    ;;
  services)
    run_script services "$@"
    ;;
  check)
    run_script check "$@"
    ;;
  new|new-project)
    run_script new-project "$@"
    ;;
  update)
    run_script update "$@"
    ;;
  *)
    printf '%sORBIT%s: unknown command %q\n\n' \
      "$color_rose" "$color_reset" "$command" >&2
    usage >&2
    exit 2
    ;;
esac
