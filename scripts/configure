#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/env.sh"
if [ "$#" -eq 1 ] && [ "$1" = --plan ]; then
  plan_python=/usr/bin/python3
  if [ ! -x "$plan_python" ]; then
    plan_python=$(command -v python3) || {
      echo 'Python 3 is needed to preview managed files; install Apple Command Line Tools first.' >&2
      exit 1
    }
  fi
  exec "$plan_python" "$ORBIT_ROOT/scripts/configure.py" --plan
fi
if [ "$#" -ne 0 ]; then
  printf 'Usage: scripts/configure [--plan]\n' >&2
  exit 2
fi
mkdir -p "$HOME/.config/orbit" "$ORBIT_ROOT/.state/backups"
# The Python configurator backs up changed destinations and installs them atomically.
uv run --locked --project "$ORBIT_ROOT/templates/python" python "$ORBIT_ROOT/scripts/configure.py"
echo 'Managed user configuration applied; changed files were backed up before replacement.'
