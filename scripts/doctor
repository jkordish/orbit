#!/bin/bash
set -uo pipefail
source "$(dirname "$0")/env.sh"
if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != --docker ]; }; then
  echo 'Usage: scripts/doctor [--docker]' >&2
  exit 2
fi

required_total=0
required_passed=0
required_failed=0
result_count=0
next_action=''
declare -a result_group result_label result_state result_kind result_detail

color_reset=''
color_indigo=''
color_mint=''
color_amber=''
color_rose=''
if [ -t 1 ] && [ -z "${NO_COLOR+x}" ] && [ "${TERM:-}" != dumb ]; then
  color_reset=$'\033[0m'
  color_indigo=$'\033[38;2;180;190;254m'
  color_mint=$'\033[38;2;148;226;213m'
  color_amber=$'\033[38;2;249;226;175m'
  color_rose=$'\033[38;2;243;139;168m'
fi

record_result() {
  local group=$1
  local label=$2
  local state=$3
  local kind=$4
  local detail=$5

  result_group[result_count]=$group
  result_label[result_count]=$label
  result_state[result_count]=$state
  result_kind[result_count]=$kind
  result_detail[result_count]=$detail
  result_count=$((result_count + 1))
}

required_check() {
  local group=$1
  local label=$2
  local action=$3
  shift 3
  local detail=''
  local state

  required_total=$((required_total + 1))
  if detail=$("$@" 2>&1); then
    state='PASS'
    required_passed=$((required_passed + 1))
  else
    state='FAIL'
    required_failed=$((required_failed + 1))
    if [ -z "$next_action" ]; then next_action=$action; fi
  fi
  record_result "$group" "$label" "$state" 'required' "$detail"
}


render_report() {
  local overall_state='READY'
  local overall_color=$color_mint
  local group
  local previous_group=''
  local heading
  local i
  local row_color
  local detail_line
  local detail

  if [ "$required_failed" -gt 0 ]; then
    overall_state='ATTENTION'
    overall_color=$color_rose
  fi

  printf '%sORBIT%s / MACHINE READINESS\n' "$color_indigo" "$color_reset"
  printf '  %s%s%s · %d/%d required checks passed\n' \
    "$overall_color" "$overall_state" "$color_reset" "$required_passed" "$required_total"

  for ((i = 0; i < result_count; i++)); do
    group=${result_group[$i]}
    heading=''
    if [ "$group" != "$previous_group" ]; then
      case "$group" in
        Repository) heading='REPOSITORY' ;;
        Foundation) heading='FOUNDATION' ;;
        Languages) heading='LANGUAGES' ;;
        Containers) heading='CONTAINERS' ;;
        Platform) heading='PLATFORM' ;;
      esac
    fi

    case "${result_kind[$i]}:${result_state[$i]}" in
      required:PASS|advisory:SIGNED\ IN|info:TERMS\ ACCEPTED) row_color=$color_mint ;;
      required:FAIL) row_color=$color_rose ;;
      info:SYNCED) row_color=$color_mint ;;
      *) row_color=$color_amber ;;
    esac
    detail=''
    if [ -n "${result_detail[$i]}" ] \
      && [ "${result_state[$i]}" != 'FAIL' ] \
      && [ "${result_state[$i]}" != 'SIGN-IN NEEDED' ] \
      && [ "${result_state[$i]}" != 'CONSENT NEEDED' ] \
      && [ "${result_state[$i]}" != 'STATUS UNKNOWN' ]; then
      detail=${result_detail[$i]%%$'\n'*}
      detail=${detail//$'\t'/ }
      if [ "${#detail}" -gt 22 ]; then detail="${detail:0:19}..."; fi
    fi
    printf '  %-12s %-23s %s%-16s%s' \
      "$heading" "${result_label[$i]}" "$row_color" "${result_state[$i]}" "$color_reset"
    if [ -n "$detail" ]; then printf '  %s' "$detail"; fi
    printf '\n'
    previous_group=$group

    if [ -n "${result_detail[$i]}" ] \
      && { [ "${result_state[$i]}" = 'FAIL' ] \
        || [ "${result_state[$i]}" = 'SIGN-IN NEEDED' ] \
        || [ "${result_state[$i]}" = 'CONSENT NEEDED' ] \
        || [ "${result_state[$i]}" = 'STATUS UNKNOWN' ]; }; then
      while IFS= read -r detail_line; do
        printf '      %s\n' "$detail_line" >&2
      done <<< "${result_detail[$i]}"
    fi
  done

  printf '\nNEXT  '
  if [ -n "$next_action" ]; then
    printf '%s\n' "$next_action"
  else
    printf 'All set. No changes needed.\n'
  fi
}

repository_result=$("$ORBIT_ROOT/scripts/repository-status" "$ORBIT_ROOT")
IFS=$'\t' read -r repository_state repository_detail repository_action <<< "$repository_result"
if [ -z "$repository_state" ]; then
  repository_state='UNAVAILABLE'
  repository_detail='Git checkout status unavailable'
  repository_action='Inspect this Git checkout manually before syncing.'
fi
record_result 'Repository' 'Git checkout' "$repository_state" 'info' "$repository_detail"

python_template="$ORBIT_ROOT/templates/python/.venv/bin/python"

required_check 'Foundation' 'Apple developer tools' \
  "Run 'xcode-select --install', then rerun './scripts/doctor'." \
  xcrun --find clang
if command -v brew >/dev/null 2>&1; then
  brew_action="Run './scripts/apply', then rerun './scripts/doctor'."
else
  brew_action="Run './bootstrap.command', then rerun './scripts/doctor'."
fi
required_check 'Foundation' 'Brewfile packages' \
  "$brew_action" \
  brew bundle check --file="$ORBIT_ROOT/Brewfile"
required_check 'Foundation' 'Optional profiles' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  "$ORBIT_ROOT/scripts/profiles" --check

if grep -Fxq java "$ORBIT_ROOT/.state/profiles.txt" \
  || grep -Fxq java "$ORBIT_ROOT/config/profiles.txt"; then
  java_binary="$(brew --prefix openjdk@21)/libexec/openjdk.jdk/Contents/Home/bin/java"
  required_check 'Foundation' 'Java runtime' \
    "Run './scripts/apply', then rerun './scripts/doctor'." \
    "$java_binary" -version
fi

required_check 'Languages' 'Node' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  env MISE_AUTO_INSTALL=0 MISE_EXEC_AUTO_INSTALL=0 MISE_NOT_FOUND_AUTO_INSTALL=0 MISE_OFFLINE=1 \
  mise exec --no-deps --cd "$ORBIT_ROOT/config" -- node --version
required_check 'Languages' 'Go' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  env MISE_AUTO_INSTALL=0 MISE_EXEC_AUTO_INSTALL=0 MISE_NOT_FOUND_AUTO_INSTALL=0 MISE_OFFLINE=1 \
  mise exec --no-deps --cd "$ORBIT_ROOT/config" -- go version
required_check 'Languages' 'pnpm' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  env MISE_AUTO_INSTALL=0 MISE_EXEC_AUTO_INSTALL=0 MISE_NOT_FOUND_AUTO_INSTALL=0 MISE_OFFLINE=1 \
  mise exec --no-deps --cd "$ORBIT_ROOT/config" -- pnpm --version
required_check 'Languages' 'Stable Rust' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  rustc +stable --version
required_check 'Languages' 'Pinned Cargo utilities' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  env PYTHONDONTWRITEBYTECODE=1 "$python_template" "$ORBIT_ROOT/scripts/rust-tools.py" --check
required_check 'Containers' 'Docker Compose' \
  "Run './scripts/apply', then rerun './scripts/doctor'." \
  docker compose version

if [ -x /usr/bin/fm ]; then
  fm_license_status=''
  fm_license_exit=0
  if fm_license_status=$(/usr/bin/fm license --status 2>&1); then
    fm_license_exit=0
  else
    fm_license_exit=$?
  fi
  case "$fm_license_status" in
    *"Agreed to license"*|*"AGREED TO LICENSE"*)
      if [ "$fm_license_exit" -eq 0 ]; then
        record_result 'Platform' 'Apple Foundation Models' 'TERMS ACCEPTED' 'info' \
          'System-wide Foundation Models CLI terms are accepted.'
      else
        record_result 'Platform' 'Apple Foundation Models' 'STATUS UNKNOWN' 'optional' \
          '/usr/bin/fm license --status returned an error; inspect the command output manually.'
      fi
      ;;
    *"not agreed"*|*"NOT AGREED"*)
      record_result 'Platform' 'Apple Foundation Models' 'CONSENT NEEDED' 'optional' \
        "Review the system-wide terms yourself with 'sudo /usr/bin/fm license'; consent is never automated."
      ;;
    *)
      record_result 'Platform' 'Apple Foundation Models' 'STATUS UNKNOWN' 'optional' \
        'Could not interpret /usr/bin/fm license --status; inspect the command output manually.'
      ;;
  esac
else
  record_result 'Platform' 'Apple Foundation Models' 'NOT INCLUDED' 'optional' \
    'Apple includes /usr/bin/fm with macOS 27 and later.'
fi

if [ -z "$next_action" ] && [ -n "$repository_action" ]; then next_action=$repository_action; fi


render_report
if [ "$required_failed" -gt 0 ]; then
  exit 1
fi
exit 0
