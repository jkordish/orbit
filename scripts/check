#!/bin/bash
set -euo pipefail
source "$(dirname "$0")/env.sh"
cd "$ORBIT_ROOT"
shell_scripts=(bootstrap.command install.sh setup scripts/apply scripts/configure scripts/doctor scripts/recovery scripts/repository-status scripts/sync scripts/check scripts/services scripts/docker-start scripts/container-check scripts/update scripts/macos-defaults scripts/env.sh scripts/prepare-environments scripts/rust-tools scripts/profiles scripts/plan scripts/new-project scripts/orbit scripts/projects scripts/enter scripts/orbit-python)
for script in "${shell_scripts[@]}"; do bash -n "$script"; done
shellcheck -x "${shell_scripts[@]}"
zsh -n config/shell.zsh
python_sources=(templates/python scripts/configure.py scripts/rust-tools.py scripts/test-ai-ignore.py scripts/test-starship-trust.py scripts/test-repository-status.py scripts/new_project.py scripts/test-new-project.py scripts/test-recovery.py scripts/test-plan.py scripts/test-enter.py scripts/test-workspace.py scripts/test-git-map.py scripts/test-orbit-core.py scripts/orbit_cli.py scripts/orbit_core)
uv run --locked --project templates/python ruff check "${python_sources[@]}"
uv run --locked --project templates/python mypy templates/python
uv run --locked --project templates/python mypy scripts/orbit_core scripts/orbit_cli.py
uv run --locked --project templates/python pytest -q templates/python
uv run --locked --project templates/python python scripts/test-configure.py
uv run --locked --project templates/python python scripts/test-plan.py
uv run --locked --project templates/python python scripts/test-enter.py
uv run --locked --project templates/python python scripts/test-workspace.py
uv run --locked --project templates/python python scripts/test-git-map.py
uv run --locked --project templates/python python scripts/test-orbit-core.py
./scripts/profiles --verify-catalog
uv run --locked --project templates/python python scripts/test-relocation.py
uv run --locked --project templates/python python scripts/test-profiles.py
uv run --locked --project templates/python python scripts/test-sync.py
uv run --locked --project templates/python python scripts/test-repository-status.py
uv run --locked --project templates/python python scripts/test-ai-ignore.py
uv run --locked --project templates/python python scripts/test-starship-trust.py
uv run --locked --project templates/python python scripts/test-new-project.py
uv run --locked --project templates/python python scripts/test-recovery.py
mise exec --cd templates/typescript -- pnpm install --frozen-lockfile
mise exec --cd templates/typescript -- pnpm check
mise exec --cd templates/typescript -- pnpm test
mise exec --cd templates/go -- go test ./...
mise exec --cd templates/go -- go vet ./...
(cd templates/rust && cargo test --locked && cargo clippy --locked --all-targets -- -D warnings && cargo fmt --check)
echo 'All configuration and language checks passed.'
