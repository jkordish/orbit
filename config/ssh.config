# Managed by orbit. Private keys stay in your existing OpenSSH agent or ~/.ssh.
# This host profile is intentionally opt-in for GitHub transport: existing
# HTTPS remotes remain usable until `ssh -T git@github.com` succeeds.
Host github.com
    HostName github.com
    User git
    PreferredAuthentications publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ForwardAgent no
    ConnectTimeout 10
    ServerAliveInterval 30
    ServerAliveCountMax 3
