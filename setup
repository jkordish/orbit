#!/bin/bash
set -euo pipefail
ORBIT_ROOT=$(cd "$(dirname "$0")" && pwd -P)
cd "$ORBIT_ROOT"

usage() {
  cat <<'EOF'
Usage: ./setup [--resume] [--profile NAME|all]...

Provision the complete managed Apple Silicon workstation:
Homebrew, profiles, locked runtimes, user configuration, services, a pinned
container smoke check, repository checks, and a final readiness report.

The flow is safe to rerun. Existing user data is preserved, package managers
are asked to install without upgrading, and the setup lock prevents concurrent
runs from racing over the same checkout or machine configuration. If a run
stops, --resume continues from the recorded phase.

Profiles: cloud infra wasm editors autocomplete java; use --profile all for every profile.
EOF
}

resume_requested=0
setup_args=()
for argument in "$@"; do
  if [ "$argument" = --help ]; then
    usage
    exit 0
  elif [ "$argument" = --resume ]; then
    resume_requested=1
  else
    setup_args+=("$argument")
  fi
done

# Validate all arguments before creating state or touching the machine.
if [ "${#setup_args[@]}" -gt 0 ]; then
  ./scripts/profiles --validate "${setup_args[@]}"
else
  ./scripts/profiles --validate
fi
if [ "$resume_requested" -eq 1 ] && [ "${#setup_args[@]}" -gt 0 ]; then
  printf 'HOLD · --resume cannot select new profiles because it may skip apply. Run ./setup with the profile arguments to reconcile from the beginning.\n' >&2
  exit 2
fi

state_root="$ORBIT_ROOT/.state"
lock_root="$state_root/provision.lock"
state_file="$state_root/provision-state"
if [ -L "$state_root" ] || [ -L "$lock_root" ] || [ -L "$state_file" ]; then
  printf 'HOLD · setup state contains a symbolic link; inspect .state, provision.lock, and provision-state before retrying.\n' >&2
  exit 1
fi
mkdir -p "$state_root"

resume_phase=''
if [ "$resume_requested" -eq 1 ]; then
  if [ ! -r "$state_file" ]; then
    printf 'HOLD · no previous provisioning phase is recorded; run ./setup once first.\n' >&2
    exit 1
  fi
  resume_phase=$(sed -n 's/^phase=//p' "$state_file" | head -n 1)
  if [ "$resume_phase" = preflight ]; then resume_phase=bootstrap; fi
  case "$resume_phase" in
    bootstrap|apply|preferences|services|container-smoke|repository-check|readiness) ;;
    complete)
      printf 'READY · the last setup run is already complete; use ./setup to reconcile from the beginning.\n'
      exit 0
      ;;
    *)
      printf 'HOLD · provision state has no resumable phase: %s\n' "${resume_phase:-unknown}" >&2
      exit 1
      ;;
  esac
fi

acquire_lock() {
  if mkdir "$lock_root" 2>/dev/null; then
    printf '%s\n' "$$" > "$lock_root/pid"
    return 0
  fi

  lock_pid=''
  if [ -r "$lock_root/pid" ]; then lock_pid=$(cat "$lock_root/pid"); fi
  if [ -z "$lock_pid" ]; then
    printf 'HOLD · another setup run is establishing its lock. Try again shortly.\n' >&2
    exit 1
  fi
  if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
    printf 'HOLD · another setup run is active (pid %s).\n' "$lock_pid" >&2
    exit 1
  fi

  printf 'RECOVER · removing stale setup lock%s.\n' \
    "${lock_pid:+ from pid $lock_pid}" >&2
  rm -rf "$lock_root"
  mkdir "$lock_root"
  printf '%s\n' "$$" > "$lock_root/pid"
}

acquire_lock
cleanup() { rm -rf "$lock_root"; }
trap cleanup EXIT

started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
phase='preflight'
resuming=0
phase_number=0
phase_total=7
setup_started=$SECONDS
interactive=0
color_reset=''
color_indigo=''
color_mint=''
color_amber=''
color_rose=''
color_muted=''
if [ -t 1 ] && [ "${TERM:-}" != dumb ]; then
  interactive=1
fi
if [ "$interactive" -eq 1 ] && [ -z "${NO_COLOR+x}" ]; then
  color_reset=$'\033[0m'
  color_indigo=$'\033[38;2;180;190;254m'
  color_mint=$'\033[38;2;148;226;213m'
  color_amber=$'\033[38;2;249;226;175m'
  color_rose=$'\033[38;2;243;139;168m'
  color_muted=$'\033[38;2;166;173;200m'
fi

terminal_columns() {
  local size
  if size=$(stty size 2>/dev/null </dev/tty); then
    size=${size##* }
    if [ "$size" -gt 0 ] 2>/dev/null; then
      printf '%s\n' "$size"
      return
    fi
  fi
  printf '%s\n' "${COLUMNS:-80}"
}

rule() {
  local spaces
  printf -v spaces '%*s' "$1" ''
  printf '%s' "${spaces// /─}"
}

phase_title() {
  case "$1" in
    bootstrap) printf 'Bootstrap\n' ;;
    apply) printf 'Tools & config\n' ;;
    preferences) printf 'macOS settings\n' ;;
    services) printf 'Container service\n' ;;
    container-smoke) printf 'Container check\n' ;;
    repository-check) printf 'Repository checks\n' ;;
    readiness) printf 'Readiness\n' ;;
  esac
}

duration() {
  local elapsed=$1
  if [ "$elapsed" -ge 3600 ]; then
    printf '%sh %sm\n' "$((elapsed / 3600))" "$(((elapsed % 3600) / 60))"
  elif [ "$elapsed" -ge 60 ]; then
    printf '%sm %ss\n' "$((elapsed / 60))" "$((elapsed % 60))"
  else
    printf '%ss\n' "$elapsed"
  fi
}

setup_heading() {
  local width
  if [ "$interactive" -eq 0 ]; then
    printf 'ORBIT / SETUP\n  %s phases · repeat-safe\n' "$phase_total"
    if [ "$resume_requested" -eq 1 ]; then
      printf '  RESUME · from %s\n' "$(phase_title "$resume_phase")"
    fi
    return
  fi
  width=$(terminal_columns)
  case "$width" in
    ''|*[!0-9]*) width=80 ;;
  esac
  printf '\n  %s◉ ORBIT / SETUP%s\n' "$color_indigo" "$color_reset"
  if [ "$width" -ge 50 ]; then
    printf '  %sA calm, repeatable workstation · %s phases%s\n' \
      "$color_muted" "$phase_total" "$color_reset"
  elif [ "$width" -lt 24 ]; then
    printf '  %s%s phases%s\n' "$color_muted" "$phase_total" "$color_reset"
  else
    printf '  %s%s phases · repeat-safe%s\n' "$color_muted" "$phase_total" "$color_reset"
  fi
  if [ "$resume_requested" -eq 1 ]; then
    if [ "$width" -lt 42 ]; then
      printf '  %sRESUME%s\n' "$color_amber" "$color_reset"
    else
      printf '  %sRESUME%s  from %s\n' "$color_amber" "$color_reset" \
        "$(phase_title "$resume_phase")"
    fi
  fi
}

phase_heading() {
  local number=$1 label=$2 width marks='' index marks_visible
  width=$(terminal_columns)
  case "$width" in
    ''|*[!0-9]*) width=80 ;;
  esac
  if [ "$width" -lt 20 ]; then width=20; fi
  if [ "$width" -gt 80 ]; then width=80; fi
  for ((index = 1; index <= phase_total; index++)); do
    if [ "$index" -lt "$number" ]; then
      marks+="${color_mint}●${color_reset} "
    elif [ "$index" -eq "$number" ]; then
      marks+="${color_indigo}◉${color_reset} "
    else
      marks+="${color_muted}○${color_reset} "
    fi
  done
  marks=${marks% }
  marks_visible=$((phase_total * 2 - 1))
  if [ "$width" -lt 42 ]; then
    printf '\n  %s%02d/%02d%s\n' "$color_indigo" "$number" "$phase_total" "$color_reset"
    printf '  %s%s%s\n' "$color_indigo" "$label" "$color_reset"
  else
    printf '\n  %s%02d/%02d%s  %s\n' "$color_indigo" "$number" "$phase_total" "$color_reset" "$label"
  fi
  printf '  %s  %s%s%s\n' "$marks" "$color_muted" \
    "$(rule "$((width - 4 - marks_visible))")" "$color_reset"
}

setup_outcome() {
  local state=$1 detail=$2 hint=$3 action=$4 tone=$5
  local short_detail=$6 short_hint=$7 width line
  if [ "$interactive" -eq 1 ]; then
    width=$(terminal_columns)
    case "$width" in
      ''|*[!0-9]*) width=80 ;;
    esac
    printf '\n  %s◉ ORBIT / %s%s\n' "$tone" "$state" "$color_reset"
    if [ "$width" -lt 42 ]; then
      while IFS= read -r line; do printf '  %s\n' "$line"; done <<< "$short_detail"
      printf '  %sNEXT%s\n' "$color_amber" "$color_reset"
      while IFS= read -r line; do printf '    %s\n' "$line"; done <<< "$short_hint"
      if [ "$width" -lt 24 ]; then
        printf '  %s%s%s\n' "$tone" "$action" "$color_reset"
      else
        printf '    %s↳ %s%s\n' "$tone" "$action" "$color_reset"
      fi
    else
      printf '  %s\n' "$detail"
      printf '  %sNEXT%s  %s\n' "$color_amber" "$color_reset" "$hint"
      printf '    %s↳ %s%s\n' "$tone" "$action" "$color_reset"
    fi
  else
    printf '\nORBIT / %s\n' "$state"
    printf '  %s\n' "$detail"
    printf '  NEXT · %s %s\n' "$hint" "$action"
  fi
}

write_state() {
  local next="$state_file.tmp.$$"
  {
    printf 'phase=%s\n' "$phase"
    printf 'started_at=%s\n' "$started_at"
    printf 'updated_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$next"
  mv "$next" "$state_file"
}

run_phase() {
  local label started status elapsed width
  phase=$1
  shift
  phase_number=$((phase_number + 1))
  label=$(phase_title "$phase")
  if [ "$resume_requested" -eq 1 ] && [ "$resuming" -eq 0 ]; then
    if [ "$phase" != "$resume_phase" ]; then
      if [ "$interactive" -eq 1 ]; then
        width=$(terminal_columns)
        case "$width" in
          ''|*[!0-9]*) width=80 ;;
        esac
        if [ "$width" -lt 42 ]; then
          printf '  %s↷ %02d/%02d skipped%s\n' \
            "$color_muted" "$phase_number" "$phase_total" "$color_reset"
          printf '  %s%s%s\n' "$color_muted" "$label" "$color_reset"
        else
          printf '  %s↷ %02d/%02d  %s · already complete%s\n' \
            "$color_muted" "$phase_number" "$phase_total" "$label" "$color_reset"
        fi
      else
        printf '  SKIP · %s (resume starts at %s)\n' "$phase" "$resume_phase"
      fi
      return 0
    fi
    resuming=1
  fi
  write_state
  if [ "$interactive" -eq 1 ]; then
    phase_heading "$phase_number" "$label"
  else
    printf '\nORBIT / %02d/%02d %s\n' "$phase_number" "$phase_total" "$label"
  fi
  started=$SECONDS
  if "$@"; then
    elapsed=$(duration "$((SECONDS - started))")
    if [ "$interactive" -eq 1 ]; then
      printf '  %s✓%s  %s · %s\n' "$color_mint" "$color_reset" "$label" \
        "$elapsed"
    else
      printf '  DONE · %s · %s\n' "$phase" "$elapsed"
    fi
    return 0
  else
    status=$?
    elapsed=$(duration "$((SECONDS - started))")
    write_state
    setup_outcome HOLD "$phase_number/$phase_total $label · exit $status · $elapsed" \
      'Resolve the error above, then run from Orbit:' './setup --resume' "$color_rose" \
      "$phase_number/$phase_total"$'\n'"$label"$'\n'"exit $status · $elapsed" \
      $'Fix error above.\nIn Orbit folder:' >&2
    exit "$status"
  fi
}

setup_heading
write_state
run_phase bootstrap env ORBIT_SETUP_CONTEXT=full ./bootstrap.command
if [ "${#setup_args[@]}" -gt 0 ]; then
  run_phase apply env ORBIT_SETUP_CONTEXT=full ./scripts/apply "${setup_args[@]}"
else
  run_phase apply env ORBIT_SETUP_CONTEXT=full ./scripts/apply
fi
run_phase preferences ./scripts/macos-defaults
run_phase services ./scripts/services
run_phase container-smoke ./scripts/container-check
run_phase repository-check ./scripts/check
run_phase readiness ./scripts/doctor

phase='complete'
write_state
total_elapsed=$(duration "$((SECONDS - setup_started))")
setup_outcome READY "$phase_total/$phase_total phases complete · $total_elapsed" \
  'Open a new terminal, then run:' 'orbit status' "$color_mint" \
  "$phase_total/$phase_total complete"$'\n'"$total_elapsed elapsed" \
  'New terminal.'
